#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE_CLICK_GUARD 8
#define MOUSE_CLICK_GUARD_MS 2000

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

&trackball_listener {
    click_guard {
        layers = <MOUSE_CLICK_GUARD>;
        input-processors = <
            &roba_mouse_click_guard
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <3 2>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <3 4>;
        };

        escape {
            bindings = <&to_layer_0 ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mouse_left_guard: mouse_left_guard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;

            bindings
                = <&macro_press &mo MOUSE_CLICK_GUARD>
                , <&macro_press &mkp MB1>
                , <&macro_wait_time MOUSE_CLICK_GUARD_MS>
                , <&macro_release &mo MOUSE_CLICK_GUARD>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB1>
                ;
        };
    };

    input_processors {
        roba_mouse_click_guard: roba_mouse_click_guard {
            compatible = "zmk,input-processor-roba-click-guard";
            #input-processor-cells = <0>;
            track-remainders;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                   &kp T                                                        &kp Y            &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                   &kp G        &kp PRINTSCREEN             &kp F8              &kp H            &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                   &kp B        &mt LEFT_SHIFT F6           &mt RIGHT_SHIFT F7  &kp N            &kp M  &kp COMMA  &kp DOT  &lt 4 SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 7 LANG2  &lt 2 LANG1  &lt_to_layer_0 1 SPACE      &lt 3 ENTER         &lt 6 BACKSPACE                             &lt 4 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM_FUNC {
            bindings = <
&kp N1     &kp N2    &kp N3    &kp N4                  &kp N5                                       &kp N6  &kp N7   &kp N8   &kp N9   &kp N0
&kp F1     &kp F2    &kp F3    &kp F4                  &kp F5                   &trans      &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans     &trans    &trans    &kp LS(LG(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &kp F6      &kp F7  &trans  &trans   &trans   &trans   &trans
&kp LCTRL  &kp LGUI  &kp LALT  &trans                  &trans                   &trans      &trans  &trans                             &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT                                          &kp CARET  &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp QUESTION     &kp PIPE     &kp TILDE  &kp COLON   &kp MINUS       &trans             &kp INT_YEN       &kp PLUS   &kp DOUBLE_QUOTES  &kp PERIOD    &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp FSLH         &kp BSLH     &kp GRAVE  &kp SEMI    &kp UNDERSCORE  &kp LESS_THAN      &kp GREATER_THAN  &kp EQUAL  &kp SQT            &kp COMMA     &kp LBKT              &kp RBKT
&kp LCTRL        &kp LGUI     &kp LALT   &trans      &trans          &trans             &trans            &trans                                                            &kp RIGHT_SHIFT
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans             &trans                                 &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans             &trans             &trans      &trans  &trans  &mouse_click_guard MB1  &mouse_click_guard MB3  &mouse_click_guard MB2  &trans
&trans  &trans  &trans  &trans             &trans             &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &to_layer_0 LANG2  &to_layer_0 LANG1  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        NUM {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                                 &kp TILDE        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH
&kp DOLLAR       &kp PERCENT   &kp CARET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans              &kp SEMI   &kp COLON        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK
&kp AMPERSAND    &kp ASTERISK  &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp QUESTION        &kp EQUAL  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS
&kp LCTRL        &kp LGUI      &kp LALT   &trans                &kp BACKSLASH          &kp UNDERSCORE      &kp COMMA  &kp PERIOD                                                          &kp PLUS
            >;
        };

        MOUSE_CLICK_GUARD {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
